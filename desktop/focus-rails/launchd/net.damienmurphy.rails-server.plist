<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<plist version="1.0">
<dict>
    <key>Label</key>
    <string>net.damienmurphy.rails-server</string>

    <key>ProgramArguments</key>
    <array>
        <string>RAILS_SERVE_SCRIPT</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/rails-server.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/rails-server.err</string>
</dict>
</plist>
