#!/usr/bin/env bash

set -euo pipefail

MODEL="${GIT_COMMIT_MODEL:-qwen2.5-coder:7b}"

# Ensure we're inside a Git repository.
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    echo "Not inside a Git repository."
    exit 1
}

branch="$(git branch --show-current)"

if [[ -z "$branch" ]]; then
    echo "Detached HEAD; refusing to ship."
    exit 1
fi

# Preserve an intentional staged selection. If nothing is staged, treat the
# entire working tree as the selection for this commit.
if git diff --cached --quiet; then
    echo "No staged changes found; staging all changes."
    git add -A
else
    echo "Existing staged selection found; leaving unstaged changes untouched."
fi

if git diff --cached --quiet; then
    echo "No changes to commit."
    exit 0
fi

diff="$(git diff --cached --no-color)"

prompt="$(cat <<EOF
Generate a concise Git commit message for the following staged diff.

Requirements:
- Return only the commit message.
- Use a single-line imperative subject.
- Keep it concise.
- Describe the intent of the change, not individual diff mechanics.
- Do not use Markdown.
- Do not add quotes.
- Do not invent information not present in the diff.

Diff:

$diff
EOF
)"

generate_commit_message() {
    local output

    output="$(printf '%s' "$prompt" | ollama run "$MODEL")" || return 1
    # The backtick in this single-quoted expression is intentionally literal.
    # shellcheck disable=SC2016
    printf '%s\n' "$output" |
        sed -n -e '1{s/^["`]*//; s/["`]*$//; p;}'
}

commit_message=""

while [[ -z "$commit_message" ]]; do
    if generated_message="$(generate_commit_message)" && [[ -n "$generated_message" ]]; then
        commit_message="$generated_message"
        break
    fi

    echo
    echo "Failed to generate a commit message with Ollama."

    while true; do
        read -r -p "Retry, enter a message manually, or abort? [r/m/a] " response

        case "$response" in
            [rR])
                break
                ;;

            [mM])
                read -r -e -p "Commit message: " manual_message

                if [[ -n "$manual_message" ]]; then
                    commit_message="$manual_message"
                    break
                fi

                echo "Commit message cannot be empty."
                ;;

            [aA])
                echo "Aborted."
                exit 1
                ;;

            *)
                echo "Enter r, m, or a."
                ;;
        esac
    done
done

while true; do
    echo
    echo "Files:"

    while IFS=$'\t' read -r status path1 path2; do
        type="${status:0:1}"

        case "$type" in
            R | C)
                printf ' %s %s -> %s\n' "$type" "$path1" "$path2"
                ;;
            *)
                printf ' %s %s\n' "$type" "$path1"
                ;;
        esac
    done < <(git diff --cached --name-status)

    echo
    echo "Commit:"
    echo " $commit_message"
    echo

    read -r -p "Commit and push? [Y/e/n] " response

    case "${response:-Y}" in
        [yY] | [yY][eE][sS])
            break
            ;;

        [eE])
            echo
            read -r -e -p "Commit message: " -i "$commit_message" edited_message

            if [[ -n "$edited_message" ]]; then
                commit_message="$edited_message"
            fi
            ;;

        [nN] | [nN][oO])
            echo "Aborted."
            exit 1
            ;;

        *)
            echo "Enter y, e, or n."
            ;;
    esac
done

echo
git commit -m "$commit_message"

echo
echo "Rebasing onto origin/$branch..."
git pull --rebase origin "$branch"

echo
echo "Pushing origin/$branch..."
git push origin "$branch"

echo
echo "Shipped $branch."
