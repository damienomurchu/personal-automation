#!/usr/bin/env python3

import json
import subprocess
import sys
from datetime import datetime


def send(proc, message):
    proc.stdin.write(json.dumps(message) + "\n")
    proc.stdin.flush()


def wait_for_response(proc, request_id):
    for line in proc.stdout:
        message = json.loads(line)

        if message.get("id") != request_id:
            continue

        if "error" in message:
            raise RuntimeError(message["error"])

        return message["result"]

    raise RuntimeError("Codex app-server exited unexpectedly")


def format_window(window):
    duration = window.get("windowDurationMins")
    remaining = max(0, 100 - window["usedPercent"])

    labels = {
        300: "5h",
        10080: "week",
    }

    label = labels.get(duration, f"{duration}m")

    resets_at = window.get("resetsAt")
    if resets_at:
        reset = datetime.fromtimestamp(resets_at).astimezone()

        if duration == 300:
            reset_text = reset.strftime("%H:%M")
        else:
            reset_text = reset.strftime("%a %d %b %H:%M")

        return f"{label:>4}: {remaining:3}% remaining  (resets {reset_text})"

    return f"{label:>4}: {remaining:3}% remaining"


def main():
    proc = subprocess.Popen(
        ["codex", "app-server", "--stdio"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        bufsize=1,
    )

    try:
        send(
            proc,
            {
                "method": "initialize",
                "id": 1,
                "params": {
                    "clientInfo": {
                        "name": "codex-usage",
                        "title": "Codex Usage",
                        "version": "1.0",
                    }
                },
            },
        )

        wait_for_response(proc, 1)

        send(proc, {"method": "initialized"})

        send(
            proc,
            {
                "method": "account/rateLimits/read",
                "id": 2,
            },
        )

        result = wait_for_response(proc, 2)
        limits = result["rateLimits"]

        print("Codex usage")

        for window in (limits.get("primary"), limits.get("secondary")):
            if window:
                print(format_window(window))

    except FileNotFoundError:
        print("error: codex executable not found", file=sys.stderr)
        return 1
    except Exception as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    finally:
        proc.terminate()

    return 0


if __name__ == "__main__":
    sys.exit(main())
